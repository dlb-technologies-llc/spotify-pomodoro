{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "node_modules", "playwright-report", "test-results"],
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"plugins": [{ "name": "@effect/language-service" }]
	}
}
