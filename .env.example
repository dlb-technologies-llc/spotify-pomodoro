# Spotify app (https://developer.spotify.com/dashboard)
PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:2500/callback

# Optional login (username is always "admin")
AUTH_ENABLED=false
AUTH_PASSWORD=changeme
AUTH_SECRET=generate-a-random-32-character-string-here

# Optional
# DATABASE_URL=file:./data/pomodoro.db
# OTEL_COLLECTOR_URL=http://localhost:4318
# LOG_LEVEL=info
# PUBLIC_LOG_LEVEL=info

# Live Spotify tests (bun run spotify:token)
# SPOTIFY_REFRESH_TOKEN=
