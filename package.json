{
	"name": "spotify-pomodoro",
	"type": "module",
	"version": "2.0.0",
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"start": "node ./dist/server/entry.mjs",
		"astro": "astro",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "astro check",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:live": "vitest run --project live",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "bun run lint && bun run typecheck && bun run test",
		"spotify:token": "bun scripts/spotify-token.ts",
		"docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
		"docker:prod": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.7",
		"@astrojs/react": "^7.0.1",
		"@effect/atom-react": "^4.0.3",
		"@effect/platform-browser": "^4.0.3",
		"@effect/sql-libsql": "^4.0.3",
		"@radix-ui/react-dialog": "^1.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.8",
		"clsx": "^2.1.1",
		"effect": "^4.0.3",
		"lucide-react": "^1.55.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@effect/language-service": "^0.87.4",
		"@effect/vitest": "^4.0.3",
		"@playwright/test": "^1.64.0",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.4"
	}
}
