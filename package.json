{
	"name": "spotify-pomodoro",
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"start": "node ./dist/server/entry.mjs",
		"astro": "astro",
		"lint": "oxlint --type-aware --tsconfig tsconfig.json --deny-warnings && oxfmt --check .",
		"lint:fix": "oxlint --type-aware --tsconfig tsconfig.json --fix && oxfmt .",
		"typecheck": "astro check",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:live": "vitest run --project live",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:visual": "scripts/visual.sh",
		"test:visual:update": "scripts/visual.sh --update-snapshots",
		"lighthouse": "lhci autorun",
		"check": "bun run lint && bun run typecheck && bun run test",
		"spotify:token": "bun scripts/spotify-token.ts",
		"docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
		"docker:prod": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"format": "oxfmt ."
	},
	"dependencies": {
		"@astrojs/node": "^11.1.7",
		"@astrojs/react": "^7.0.1",
		"@effect/atom-react": "^4.0.3",
		"@effect/platform-browser": "^4.0.3",
		"@effect/sql-libsql": "^4.0.3",
		"@radix-ui/react-dialog": "^1.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.8",
		"clsx": "^2.1.1",
		"effect": "^4.0.3",
		"lucide-react": "^1.55.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@effect/language-service": "^0.87.4",
		"@effect/vitest": "^4.0.3",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.0",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.4"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "bun@1.3.13"
}
