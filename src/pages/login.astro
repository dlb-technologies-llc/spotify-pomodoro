---
/**
 * Login page for authenticated deployments.
 *
 * @module
 * @since 1.1.0
 * @category Pages
 */
import "@/styles/global.css";
import { Login as LoginForm } from "@/components/Login";

const returnUrl = Astro.url.searchParams.get("return") || "/";
export const prerender = false;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="theme-color" content="#f0ebe4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1a1820" media="(prefers-color-scheme: dark)" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>Login - Spotify Pomodoro</title>
		<meta name="description" content="Login to access Spotify Pomodoro" />
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<LoginForm client:load returnUrl={returnUrl} />
	</body>
</html>
